---
import ToolMarks from "./ToolMarks.astro";
const base = import.meta.env.BASE_URL;
---
<section class="silver-game" id="silver-game" aria-labelledby="silver-title">
  <header><p>把想法写成游戏 / GAME LAB</p><span>2026 · 开发中</span></header>
  <div class="game-heading"><h2 id="silver-title">这银子<br /><span>我先偷了</span><sup>！</sup></h2><div class="game-authorship"><p class="contribution-label">个人贡献 / 独立创作</p><h3>全流程独立制作<br /><em>AI Coding</em> 驱动实现</h3><p class="game-note">由我独立完成游戏 Demo 全流程，以 AI 辅助编程实现交互，并使用 Blender 辅助三维制作。</p><ToolMarks tools={[{id:"unity",name:"Unity",detail:"游戏开发与交互"},{id:"blender",name:"Blender",detail:"三维制作辅助"}]} /><button type="button" data-game-open><i data-lucide="play"></i>观看实机演示 <span>01:39</span></button></div></div>
  <button class="game-scene" type="button" data-game-open aria-label="播放这银子我先偷了游戏实机演示"><img src={`${base}assets/images/silver-game.png`} alt="这银子我先偷了：水乡建筑、石桥与码头组成的游戏关卡" loading="lazy" /><span class="scene-play"><i data-lucide="play"></i></span></button>
  <div class="game-caption"><span>这银子我先偷了 / 游戏场景</span><span>UNITY · 实机录屏</span></div>
</section>
<dialog class="game-dialog" aria-labelledby="game-dialog-title">
  <header><h2 id="game-dialog-title">这银子我先偷了 <span>实机演示</span></h2><button type="button" data-game-close aria-label="关闭游戏演示" title="关闭"><i data-lucide="x"></i></button></header>
  <video controls playsinline preload="none" poster={`${base}assets/images/silver-game.png`}><source src={`${base}assets/video/silver-game-demo.mp4`} type="video/mp4" /></video>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".game-dialog")!;
  const video = dialog.querySelector("video")!;
  let source: HTMLElement | null = null;
  let overflow = "";
  document.querySelectorAll<HTMLElement>("[data-game-open]").forEach(button => button.addEventListener("click", () => {
    source = button; overflow = document.documentElement.style.overflow; document.documentElement.style.overflow = "hidden";
    dialog.showModal(); void video.play().catch(() => {});
  }));
  dialog.querySelector("[data-game-close]")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener("close", () => { video.pause(); document.documentElement.style.overflow = overflow; source?.focus({ preventScroll: true }); });
</script>
<style>
  .silver-game { padding: 64px var(--pad) 32px; background: #a1e4dc; color: #103531; }
  .silver-game header { display: flex; justify-content: space-between; gap: 20px; font-size: 12px; border-bottom: 1px solid #10353140; padding-bottom: 18px; }
  .game-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; padding: 36px 0 12px; }
  h2 { font-size: 68px; line-height: 1.13; }
  h2 span { color: #005f54; } sup { font-size: 36px; vertical-align: top; }
  .game-heading p { font-size: 20px; } .game-heading .game-note { font-size: 14px; margin: 10px 0 24px; }
  .game-authorship { width: min(100%,460px); }
  .game-heading .contribution-label { font-size: 12px; font-weight: 600; margin-bottom: 12px; }
  .game-authorship h3 { font-size: 28px; line-height: 1.45; }
  .game-authorship em { font-style: normal; color: #00564c; }
  .game-authorship .game-note { line-height: 1.8; }
  .game-authorship button { margin-top: 26px; }
  .game-heading button { display: inline-flex; align-items: center; gap: 16px; min-height: 52px; padding: 10px 22px; border: 0; background: #133d35; color: white; border-radius: 4px; cursor: pointer; font-size: 15px; }
  .game-heading button span { font-size: 12px; color: #c5eae0; }
  button svg { width: 20px; }
  .game-scene { display: block; width: 100%; position: relative; border: 0; padding: 0; background: transparent; cursor: pointer; }
  .game-scene img { display: block; width: 100%; height: auto; aspect-ratio: 1818/1018; object-fit: contain; }
  .scene-play { position: absolute; right: 3%; bottom: 5%; width: 62px; height: 62px; border-radius: 50%; display: grid; place-items: center; color: #14362f; background: #ffffffbb; backdrop-filter: blur(12px); transition: transform .25s; }
  .game-scene:hover .scene-play { transform: scale(1.1); }
  button:focus-visible { outline: 3px solid #0059ed; outline-offset: 5px; }
  .game-caption { display: flex; justify-content: space-between; font-size: 12px; gap: 20px; padding-top: 18px; border-top: 1px solid #10353140; }
  .game-dialog { position: fixed; inset: 0; margin: auto; padding: 0; width: min(1280px,96vw); border: 0; border-radius: 6px; color: #fff; background: #131518; max-height: 96dvh; }
  .game-dialog::backdrop { background: #000c; backdrop-filter: blur(10px); }
  .game-dialog header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 16px; }
  .game-dialog h2 { font-size: 18px; line-height: 1.5; }.game-dialog h2 span { color: #b8bfc6; font-size: 12px; margin-left: 12px; }
  .game-dialog header button { width: 44px; height: 44px; border: 1px solid #ffffff55; border-radius: 50%; color: #fff; background: transparent; display: grid; place-items: center; flex-shrink: 0; cursor: pointer; }
  .game-dialog video { display: block; width: 100%; max-height: calc(96dvh - 80px); aspect-ratio: 16/9; background: #000; }
  @media(max-width:700px) { .silver-game { padding-top: 42px; } .game-heading { display: block; padding-top: 26px; } h2 { font-size: 44px; } .game-heading>div { margin-top: 22px; } .game-heading p { font-size: 18px; } .scene-play { width: 44px; height: 44px; } .game-scene { margin: 20px 0; } .game-caption { font-size: 10px; } .game-dialog h2 span { display: block; margin: 0; } }
  @media(prefers-reduced-motion:reduce) { .scene-play { transition: none; } }
</style>
