---
const base = import.meta.env.BASE_URL;
---

<section id="profile-intro" class="profile-intro" aria-label="王馨苑个人简介">
  <button class="profile-art" data-profile-open aria-label="放大查看王馨苑个人简介">
    <img src={`${base}assets/images/about-profile.png`} alt="王馨苑 ABOUT ME：北京邮电大学数字媒体艺术专业，获奖经历、实践经历、个人介绍与创作工具" loading="lazy" />
    <span class="expand"><i data-lucide="maximize-2"></i></span>
  </button>
  <div class="profile-readable">
    <p class="eyebrow">DIGITAL MEDIA ART</p>
    <h2>王馨苑 <span>ABOUT ME</span></h2>
    <p>我是AIGC创作的兴趣实践者，希望探索AI辅助三维游戏动画制作，进一步完善AI与三维制作流程之间的衔接。</p>
    <p>在创作中，我希望以导演的视角明确目标，把控风格和叙事，并协调AI参与设定、建模、动画与引擎实现等环节，将想法逐步转化为完整作品。</p>
    <p>北京邮电大学 · 数字媒体艺术</p>
  </div>
  <a class="profile-next" href="#work">SELECTED WORK <i data-lucide="arrow-down-right"></i></a>
</section>
<dialog class="profile-dialog" aria-label="个人简介原图">
  <button class="profile-close" aria-label="关闭个人简介"><i data-lucide="x"></i></button>
  <img src={`${base}assets/images/about-profile.png`} alt="王馨苑完整个人简介：基本信息、获奖经历、实践经历、个人介绍和创作工具" />
</dialog>

<script>
  const section = document.querySelector<HTMLElement>(".profile-intro");
  const dialog = document.querySelector<HTMLDialogElement>(".profile-dialog");
  const trigger = section?.querySelector<HTMLButtonElement>("[data-profile-open]");
  trigger?.addEventListener("click", () => dialog?.showModal());
  dialog?.querySelector(".profile-close")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener("close", () => trigger?.focus({ preventScroll: true }));
  if (section && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        section.animate([{ opacity: .25, transform: "translateY(32px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 700, easing: "cubic-bezier(.22,1,.36,1)" });
        observer.disconnect();
      }
    }, { threshold: .12 });
    observer.observe(section);
    document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
  }
</script>

<style>
  .profile-intro { padding: 96px var(--pad) 40px; background: #fff; scroll-margin-top: 76px; }
  .profile-art { position: relative; display: block; width: 100%; max-width: 1680px; margin: auto; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .profile-art img { width: 100%; height: auto; aspect-ratio: 1671 / 941; object-fit: contain; }
  .expand { position: absolute; bottom: 22px; right: 22px; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #005cff; box-shadow: 0 2px 12px #0002; transition: transform .2s; }
  .expand svg { width: 20px; }
  .profile-art:hover .expand { transform: scale(1.08); }
  .profile-art:focus-visible, .profile-close:focus-visible { outline: 3px solid #005cff; outline-offset: 5px; }
  .profile-readable { display: none; }
  .profile-next { display: flex; align-items: center; justify-content: flex-end; gap: 16px; min-height: 48px; margin-top: 24px; font-size: 13px; font-weight: 700; }
  .profile-next svg { width: 20px; }
  .profile-dialog { position: fixed; inset: 0; width: 96vw; max-width: 1900px; max-height: 94svh; margin: auto; padding: 56px 16px 16px; border: 0; background: #fff; overflow: auto; }
  .profile-dialog::backdrop { background: #101016cc; backdrop-filter: blur(10px); }
  .profile-dialog img { width: 100%; min-width: 1000px; max-width: none; height: auto; }
  .profile-close { position: sticky; top: 0; left: 0; display: grid; place-items: center; width: 44px; height: 44px; margin-top: -48px; margin-bottom: 8px; border: 0; border-radius: 50%; color: white; background: #111; cursor: pointer; z-index: 1; }
  @media(max-width: 700px) {
    .profile-intro { padding-top: 40px; }
    .expand { right: 8px; bottom: 8px; }
    .profile-readable { display: grid; gap: 18px; margin-top: 32px; }
    .profile-readable h2 { font-size: 30px; }
    .profile-readable h2 span { display: block; font-size: 15px; color: #005cff; margin-top: 8px; }
    .profile-readable p { font-size: 16px; line-height: 1.8; }
  }
  @media(prefers-reduced-motion: reduce) { .expand { transition: none; } }
</style>
