---
interface Props { tools: { id: string; name: string; detail?: string }[]; }
const { tools } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="tool-marks" aria-label="制作工具">
  {tools.map(tool => <li><span class="tool-disc"><img src={`${base}assets/icons/${tool.id}.svg`} alt="" width="28" height="28" /></span><span><b>{tool.name}</b>{tool.detail && <small>{tool.detail}</small>}</span></li>)}
</ul>
<style>
  .tool-marks { display: flex; flex-wrap: wrap; gap: 16px 24px; list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: 10px; }
  .tool-disc { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 44px; border-radius: 50%; background: #fff; border: 1px solid #d5dcdf; }
  img { width: 28px; height: 28px; object-fit: contain; }
  b { display: block; font: 600 13px/1.4 Arial,sans-serif; }
  small { display: block; margin-top: 3px; font-size: 12px; line-height: 1.4; opacity: .75; }
</style>
