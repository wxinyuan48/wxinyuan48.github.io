---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PORTFOLIO · Wang Xinyuan",
  description = "王馨苑的个人博客与动态作品集：3D 角色、动画叙事、游戏与交互设计。",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f2" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { createIcons, ArrowDown, ArrowDownRight, ArrowLeft, ArrowRight, ArrowUpRight, ChevronLeft, ChevronUp, ChevronsRight, Copy, Mail, Maximize2, Menu, Move, Pause, Play, Rotate3d, Volume2, VolumeX, X } from "lucide";
      createIcons({ icons: { ArrowDown, ArrowDownRight, ArrowLeft, ArrowRight, ArrowUpRight, ChevronLeft, ChevronUp, ChevronsRight, Copy, Mail, Maximize2, Menu, Move, Pause, Play, Rotate3d, Volume2, VolumeX, X } });
    </script>
  </body>
</html>
