---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import IntroHero from "../components/IntroHero.astro";
import LanyardBadge from "../components/LanyardBadge.astro";
import ProfileIntro from "../components/ProfileIntro.astro";
import FilmSection from "../components/FilmSection.astro";
import ModelStage from "../components/ModelStage.astro";
import { journalEntries } from "../data/journal";
import "../styles/lower-portfolio.css";
import ArchiveViewer from "../components/ArchiveViewer.astro";
import ComicReader from "../components/ComicReader.astro";
import ProjectIndex from "../components/ProjectIndex.astro";
import GameDemo from "../components/GameDemo.astro";
import LanternFeature from "../components/LanternFeature.astro";
import GooseDemo from "../components/GooseDemo.astro";
import "../styles/editorial-type.css";
import ArtTitle from "../components/ArtTitle.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <SiteNav />
  <main>
    <IntroHero />
    <LanyardBadge />
    <ProfileIntro />

    <ProjectIndex />

    <FilmSection />
    <ModelStage />
    <GameDemo />

    <section class="nuo-archive light-band" id="nuo" aria-labelledby="nuo-title">
      <div class="section-head">
        <div><p class="eyebrow">面具之下，角色登场 / CHARACTER DESIGN</p><h2 id="nuo-title">傩戏<br />新生。</h2></div>
        <p class="section-intro">从文化符号、面具与人物比例出发，建立一套可延展的角色及衍生品系统。</p>
      </div>
      <div class="nuo-layer-scene" data-nuo-stage tabindex="0" aria-label="傩戏角色圆环档案，可用方向键切换">
        <div class="nuo-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="nuo-archive-index mono"><span>NUO / CHARACTER FILES</span><b data-nuo-counter>01 — 03</b></div>
        <div class="nuo-folders">
          <button class="nuo-folder is-center" type="button" data-nuo-character="0" aria-label="查看镇山角色">
            <span class="nuo-folder-tab mono">FILE 01</span><img src={`${base}assets/elements/nuo-folder-01.png`} alt="镇山傩戏角色" />
          </button>
          <button class="nuo-folder is-right" type="button" data-nuo-character="1" aria-label="查看赤角角色">
            <span class="nuo-folder-tab mono">FILE 02</span><img src={`${base}assets/elements/nuo-folder-02.png`} alt="赤角傩戏角色" />
          </button>
          <button class="nuo-folder is-left" type="button" data-nuo-character="2" aria-label="查看青龙角色">
            <span class="nuo-folder-tab mono">FILE 03</span><img src={`${base}assets/elements/nuo-folder-03.png`} alt="青龙傩戏角色" />
          </button>
        </div>
        <div class="nuo-file-copy">
          <p class="mono">ACTIVE CHARACTER</p><h3 data-nuo-name>ZHEN SHAN</h3><span data-nuo-cn>镇山 · 面具与少年</span>
        </div>
        <div class="nuo-ring-controls">
          <button type="button" data-nuo-prev aria-label="上一个角色"><i data-lucide="arrow-left"></i></button>
          <span class="mono">ROTATE FILE RING</span>
          <button type="button" data-nuo-next aria-label="下一个角色"><i data-lucide="arrow-right"></i></button>
        </div>
      </div>
      <div class="derivative-strip">
        <figure><img src={`${base}assets/elements/nuo-derivative-01.png`} alt="傩戏衍生设计一" loading="lazy" /><figcaption>01 / Derivative</figcaption></figure>
        <figure><img src={`${base}assets/elements/nuo-derivative-02.png`} alt="傩戏衍生设计二" loading="lazy" /><figcaption>02 / Derivative</figcaption></figure>
        <figure><img src={`${base}assets/elements/nuo-derivative-03.png`} alt="傩戏衍生设计三" loading="lazy" /><figcaption>03 / Derivative</figcaption></figure>
      </div>
    </section>

    <section class="experiments dark-band lower-section" id="experiments">
      <div class="section-head">
        <div><p class="eyebrow">身体入场，故事发生 / IMMERSIVE SPACE</p><h2 class="approved-title approved-title-space" aria-label="把规则，变成可走入的空间。"><ArtTitle variant="space" /></h2></div>
        <p class="section-intro">把抽象命题变成身体可以经历的路线、循环和反馈。</p>
      </div>
      <nav class="archive-nav" aria-label="作品分类"><span>SELECTED EXPLORATIONS / 03</span><a href="#experiments">01 交互空间</a><a href="#stories">02 叙事影像</a><a href="#commercial">03 实践设计</a></nav>
      <article class="mogule-feature" data-mogule-feature>
        <div class="mogule-stage">
          <div class="mogule-tiles" aria-hidden="true">{Array.from({ length: 12 }).map((_, index) => <span style={`--tile:${index}`}></span>)}</div>
          <div class="mogule-stage-title"><span class="mono">VR · IMMERSIVE EXPERIENCE</span><h3>FREE<br />MOGULE</h3><p>自由模数 / 循环系统 / 142857</p></div>
          <div class="mogule-branch branch-vr" aria-hidden="true"></div>
          <div class="mogule-branch branch-controller" aria-hidden="true"></div>
          <div class="mogule-branch branch-tracker" aria-hidden="true"></div>
          <div class="mogule-node node-vr">
            <span class="mono">HMD</span><img src={`${base}assets/elements/mogule-vr.png`} alt="VR 头显" />
          </div>
          <div class="mogule-node node-controller">
            <span class="mono">RECEIVER</span><img src={`${base}assets/elements/mogule-controller.png`} alt="VR 控制器" />
          </div>
          <div class="mogule-node node-tracker"><span class="tracker-shape" aria-hidden="true"></span><b>TRACKERS</b><small class="mono">BODY / SPACE</small></div>
          <div class="mogule-radar" aria-hidden="true"><i></i><i></i><i></i></div>
          <img class="mogule-person" src={`${base}assets/elements/mogule-figure-02.png`} alt="佩戴 VR 头显体验 FREE MOGULE 的人物" />
          <button class="mogule-enter" type="button" data-mogule-open><span>ENTER THE SYSTEM</span><i data-lucide="arrow-up-right"></i></button>
        </div>
        <div class="mogule-summary"><span class="mono">CORE PROPOSITION</span><p>围绕“自由”的悖论，将抽象命题拆成设备、身体与四层空间。人物先进入，系统随后在她周围被唤醒。</p></div>
      </article>

      <dialog class="mogule-dialog" data-mogule-dialog>
        <div class="mogule-dialog-bar"><div><b>FREE MOGULE</b><span class="mono">SYSTEM / 142857</span></div><button type="button" data-mogule-close aria-label="关闭项目界面"><i data-lucide="x"></i></button></div>
        <div class="mogule-system-view">
          <header><p class="eyebrow">Hierarchical Progression</p><h3>WALK THE<br />NUMBER</h3><span class="mono">01 — 04 / IMMERSIVE LEVELS</span></header>
          <section class="mogule-levels" aria-label="四层空间递进">
            <article><span class="level-dot"></span><img src={`${base}assets/elements/mogule-scene-01.png`} alt="黑暗锁链空间" /><div><b>01 / DARK CHAINS</b><p>限制感与幽暗起点</p></div></article>
            <article><span class="level-dot"></span><img src={`${base}assets/elements/mogule-scene-02.png`} alt="枯叶木屋空间" /><div><b>02 / WITHERED CABIN</b><p>循环路径与选择</p></div></article>
            <article><span class="level-dot"></span><img src={`${base}assets/elements/mogule-sculpture.png`} alt="荆棘雕塑空间" /><div><b>03 / DARK THORNS</b><p>主动突破边界</p></div></article>
            <article><span class="level-dot"></span><img src={`${base}assets/elements/mogule-world.png`} alt="蒲公英自由空间" /><div><b>04 / DANDELION FIELD</b><p>从系统中重新返回</p></div></article>
          </section>
          <section class="mogule-number-sequence">
            <p>走马灯数字</p><h4>142857</h4>
            <div><span>142857</span><i data-lucide="chevrons-right"></i><span>285714</span><i data-lucide="chevrons-right"></i><span>428571</span><i data-lucide="chevrons-right"></i><span>571428</span></div>
            <small>每一次移动都返回同一组数字，只改变观察位置。</small>
          </section>
          <section class="mogule-trace">
            <p class="eyebrow">Development Trace</p>
            <img src={`${base}assets/elements/mogule-portal.png`} alt="FREE MOGULE 传送门设计" />
            <div><b>VR / UNREAL ENGINE</b><p>从概念草图、空间建构到沉浸式交互，把视觉线索变成玩家可以穿过的规则。</p></div>
          </section>
        </div>
      </dialog>
      <article class="experiment-feature reverse" id="post-goose" data-reveal>
        <div class="goose-composition" data-parallax-scene>
          <img class="goose-postcard" src={`${base}assets/elements/goose-postcard.png`} alt="校园明信片" loading="lazy" />
          <img class="goose g1" src={`${base}assets/elements/goose-player.png`} alt="玩家雁角色" loading="lazy" />
          <img class="goose g2" src={`${base}assets/elements/goose-delivery.png`} alt="送餐雁角色" loading="lazy" />
          <img class="goose g3" src={`${base}assets/elements/goose-electronic.png`} alt="电子雁角色" loading="lazy" />
          <img class="goose g4" src={`${base}assets/elements/goose-security.png`} alt="网安雁角色" loading="lazy" />
        </div>
        <div class="experiment-copy"><span class="project-number">02 / PLAY</span><span class="mono">GAME · INTERACTION</span><h3 class="goose-title"><span>邮雁</span><small>POST GOOSE</small></h3><p>在熟悉的校园里，与不同的雁角色相遇。跟随对话与任务，展开一段校园游戏体验。</p><GooseDemo /><span class="project-tag">角色 / 校园 / 游戏机制</span></div>
      </article>
    </section>

    <section class="stories light-band lower-section" id="stories">
      <div class="section-head compact-head">
        <div><p class="eyebrow">从一格画面，到一段共鸣 / VISUAL STORIES</p><h2 class="approved-title approved-title-story" aria-label="画面之外，故事继续。"><ArtTitle variant="story" /></h2></div>
        <p class="section-intro">分镜、漫画、角色与 AIGC 动画实验，共同记录人物被创造出来的过程。</p>
      </div>
      <div class="story-grid">
        <LanternFeature />
        <figure class="comic-stack" id="comic"><div><img src={`${base}assets/comics/daozhuan/cover.jpg`} alt="倒转漫画封面" loading="lazy" /><img src={`${base}assets/comics/daozhuan/page-01.jpg`} alt="倒转漫画第一页" loading="lazy" /><img src={`${base}assets/comics/daozhuan/page-02.jpg`} alt="倒转漫画第二页" loading="lazy" /></div><figcaption><div><span>原创漫画 / 完整阅读</span><b>倒转</b></div><button type="button" data-comic-open aria-label="阅读倒转完整漫画"><i data-lucide="arrow-up-right"></i></button></figcaption></figure>
      </div>
    </section>

    <section class="commercial lower-section" id="commercial">
      <div class="commercial-title"><p class="eyebrow">走出练习，回应真实 / DESIGN IN PRACTICE</p><h2>让创意，<br />落在现场。</h2></div>
      <div class="commercial-list">
        <article data-reveal data-gallery="Sohu New Media"><span class="mono">01</span><h3>Sohu New Media</h3><p>赛事宣传、采访、短视频与平面视觉</p><div class="poster-pair"><img src={`${base}assets/elements/internship-poster-01.png`} alt="搜狐实习海报一" loading="lazy" /><img src={`${base}assets/elements/internship-poster-02.png`} alt="搜狐实习海报二" loading="lazy" /></div><button class="archive-open" type="button" data-gallery-open>查看作品 <i data-lucide="arrow-up-right"></i></button></article>
        <article data-reveal data-gallery="Campaign Objects"><span class="mono">02</span><h3>Campaign Objects</h3><p>从视觉系统中拆出的线下媒介与活动物料</p><img src={`${base}assets/elements/internship-sign.png`} alt="活动麦牌设计" loading="lazy" /><button class="archive-open" type="button" data-gallery-open>查看作品 <i data-lucide="arrow-up-right"></i></button></article>
      </div>
    </section>

    <section class="journal-preview lower-section" id="notes">
      <div class="section-head compact-head">
        <div><p class="eyebrow">作品背后，还有这些 / STUDIO NOTES</p><h2>灵感有迹，<br />创作有声。</h2></div>
        <a class="text-button" href={`${base}journal/`}><span>Open Journal</span><i data-lucide="arrow-up-right"></i></a>
      </div>
      <div class="journal-rows">
        {journalEntries.map((entry) => (
          <a href={`${base}journal/${entry.slug}/`}>
            <span class="mono">{entry.date}</span><div><small>{entry.category}</small><h3>{entry.titleEn}</h3><p>{entry.title}</p></div><i data-lucide="arrow-up-right"></i>
          </a>
        ))}
      </div>
    </section>

    <section class="about lower-section" id="about">
      <div class="about-index mono">LET'S MAKE SOMETHING / 联系我</div>
      <div class="about-copy" data-reveal><h2>LET’S<br />CREATE.</h2><p>王馨苑 / 数字媒体艺术<br />从一个想法，到一个可以被进入的世界。</p></div>
      <div class="contact-lines"><button type="button" data-copy-email aria-label="复制邮箱 buchifanqieqieqie@outlook.com"><span>EMAIL / 邮箱</span><strong>buchifanqieqieqie<wbr />@outlook.com</strong><i data-lucide="copy"></i></button><button type="button" data-copy-wechat><span>WECHAT / 微信</span><strong>15974210370</strong><i data-lucide="copy"></i></button></div>
      <div class="about-meta"><div><span>Focus</span><p>Character / World / Motion / Interaction</p></div><div><span>Tools</span><p>Blender / C4D / Unity / Adobe CC / AIGC</p></div></div>
      <footer><span>© 2026 Wang Xinyuan</span><a href="#">Back to top <i data-lucide="arrow-up-right"></i></a></footer>
    </section>
    <ArchiveViewer />
    <ComicReader />
    <p class="contact-toast" role="status" aria-live="polite" data-copy-status></p>
  </main>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.addEventListener("portfolio:layout-change", () => requestAnimationFrame(() => ScrollTrigger.refresh()));
    const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
    let toastTimer = 0;
    document.querySelectorAll<HTMLButtonElement>("[data-copy-wechat], [data-copy-email]").forEach(button => button.addEventListener("click", async () => {
      const isEmail = button.hasAttribute("data-copy-email");
      const value = isEmail ? "buchifanqieqieqie@outlook.com" : "15974210370";
      const label = isEmail ? "邮箱" : "微信号";
      try {
        await navigator.clipboard.writeText(value);
        if (copyStatus) copyStatus.textContent = `${label}已复制：${value}`;
      } catch {
        const text = button.querySelector("strong");
        if (text) { const range = document.createRange(); range.selectNodeContents(text); const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range); }
        if (copyStatus) copyStatus.textContent = `无法自动复制，已选中${label}：${value}`;
      }
      copyStatus?.classList.add("is-visible");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => copyStatus?.classList.remove("is-visible"), 3500);
    }));

    if (!reduced) {
      gsap.utils.toArray<HTMLElement>("[data-reveal], .journal-rows a").forEach(item => gsap.from(item, { y: 36, opacity: 0, duration: .85, ease: "power3.out", scrollTrigger: { trigger: item, start: "top 91%", once: true } }));
      gsap.utils.toArray<HTMLElement>(".project-index nav a").forEach((row) => {
        gsap.from(row, { y: 70, opacity: 0, duration: 0.9, ease: "power3.out", scrollTrigger: { trigger: row, start: "top 84%" } });
      });
      gsap.utils.toArray<HTMLElement>(".section-head h2, .project-index h2").forEach((heading) => {
        gsap.from(heading, { yPercent: 18, opacity: 0, duration: 1, ease: "power3.out", scrollTrigger: { trigger: heading, start: "top 86%" } });
      });
      gsap.utils.toArray<HTMLElement>(".story-grid figure").forEach((item) => {
        gsap.from(item, { y: 44, opacity: 0, duration: .9, ease: "power3.out", scrollTrigger: { trigger: item, start: "top 88%", once: true } });
      });
      document.querySelectorAll<HTMLElement>("[data-parallax-scene]").forEach((scene) => {
        scene.addEventListener("pointermove", (event) => {
          const rect = scene.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - .5;
          const y = (event.clientY - rect.top) / rect.height - .5;
          gsap.to(scene.querySelectorAll("img:not(:first-child)"), { x: (i) => x * (i + 1) * 14, y: (i) => y * (i + 1) * 10, duration: .6, ease: "power2.out" });
        });
        scene.addEventListener("pointerleave", () => gsap.to(scene.querySelectorAll("img:not(:first-child)"), { x: 0, y: 0, duration: .65, ease: "power3.out" }));
      });

      const mogule = document.querySelector<HTMLElement>("[data-mogule-feature]");
      if (mogule) {
        const person = mogule.querySelector<HTMLElement>(".mogule-person");
        const timeline = gsap.timeline({ scrollTrigger: { trigger: mogule, start: "top 72%", once: true } });
        timeline
          .from(person, { yPercent: 16, opacity: 0, scale: .92, duration: 1.05, ease: "power4.out" })
          .from(".mogule-tiles span", { xPercent: (index) => index % 2 ? 140 : -140, opacity: 0, duration: .75, stagger: { each: .035, from: "center" }, ease: "power3.out" }, "-=.48")
          .from(".mogule-stage-title > *", { y: 28, opacity: 0, duration: .65, stagger: .08, ease: "power3.out" }, "-=.55")
          .from(".mogule-branch", { scaleX: 0, duration: .55, stagger: .1, transformOrigin: "left center", ease: "power2.inOut" }, "-=.35")
          .from(".mogule-node", { scale: .45, opacity: 0, duration: .58, stagger: .1, ease: "back.out(1.7)" }, "-=.28")
          .from(".mogule-radar, .mogule-enter", { opacity: 0, scale: .8, duration: .5, stagger: .1, ease: "power2.out" }, "-=.2")
          .call(() => gsap.to(person, { y: -9, rotation: -.7, duration: 2.8, repeat: -1, yoyo: true, ease: "sine.inOut" }));
      }
    }

    const nuoStage = document.querySelector<HTMLElement>("[data-nuo-stage]");
    const nuoFiles = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-nuo-character]"));
    const nuoNames = [
      ["ZHEN SHAN", "镇山 · 面具与少年"],
      ["CHI JIAO", "赤角 · 火与祭礼"],
      ["QING LONG", "青龙 · 水与游行"],
    ];
    let activeNuo = 0;
    let nuoLocked = false;

    const rotateNuo = (next: number, direction = 1) => {
      if (!nuoStage || nuoLocked || next === activeNuo) return;
      nuoLocked = true;
      activeNuo = (next + nuoFiles.length) % nuoFiles.length;
      nuoFiles.forEach((file, index) => {
        const offset = (index - activeNuo + nuoFiles.length) % nuoFiles.length;
        file.classList.toggle("is-center", offset === 0);
        file.classList.toggle("is-right", offset === 1);
        file.classList.toggle("is-left", offset === 2);
        file.setAttribute("aria-current", offset === 0 ? "true" : "false");
      });
      const name = nuoStage.querySelector<HTMLElement>("[data-nuo-name]");
      const cn = nuoStage.querySelector<HTMLElement>("[data-nuo-cn]");
      const counter = nuoStage.querySelector<HTMLElement>("[data-nuo-counter]");
      if (name) name.textContent = nuoNames[activeNuo][0];
      if (cn) cn.textContent = nuoNames[activeNuo][1];
      if (counter) counter.textContent = `0${activeNuo + 1} — 03`;
      if (!reduced) {
        gsap.to(".nuo-orbit", { rotation: `+=${direction * 120}`, duration: .9, ease: "power3.inOut" });
        gsap.fromTo(".nuo-file-copy > *", { y: direction * 16, opacity: 0 }, { y: 0, opacity: 1, duration: .55, stagger: .055, ease: "power3.out" });
      }
      window.setTimeout(() => { nuoLocked = false; }, reduced ? 20 : 800);
    };

    nuoFiles.forEach((file, index) => file.addEventListener("click", () => {
      if (index === activeNuo) return;
      rotateNuo(index, (index - activeNuo + nuoFiles.length) % nuoFiles.length === 1 ? 1 : -1);
    }));
    nuoStage?.querySelector<HTMLButtonElement>("[data-nuo-next]")?.addEventListener("click", () => rotateNuo(activeNuo + 1, 1));
    nuoStage?.querySelector<HTMLButtonElement>("[data-nuo-prev]")?.addEventListener("click", () => rotateNuo(activeNuo - 1, -1));
    nuoStage?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") rotateNuo(activeNuo + 1, 1);
      if (event.key === "ArrowLeft") rotateNuo(activeNuo - 1, -1);
    });
    const moguleDialog = document.querySelector<HTMLDialogElement>("[data-mogule-dialog]");
    document.querySelector<HTMLButtonElement>("[data-mogule-open]")?.addEventListener("click", () => moguleDialog?.showModal());
    moguleDialog?.querySelector<HTMLButtonElement>("[data-mogule-close]")?.addEventListener("click", () => moguleDialog.close());
    moguleDialog?.addEventListener("click", (event) => { if (event.target === moguleDialog) moguleDialog.close(); });
  </script>
</BaseLayout>
