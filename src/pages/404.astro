---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 · 王馨苑">
  <main class="not-found grid-surface">
    <span class="mono">404 / LOST BETWEEN WORLDS</span>
    <h1>NOT<br />HERE.</h1>
    <a class="text-button" href={base}><span>Return Home</span><i data-lucide="arrow-up-right"></i></a>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: 100svh; padding: var(--pad); display: flex; align-items: flex-start; justify-content: space-between; flex-direction: column; }
  h1 { font-size: clamp(90px, 18vw, 280px); line-height: .72; }
</style>
